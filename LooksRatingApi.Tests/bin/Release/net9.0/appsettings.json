{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=LooksRatingDb;Username=postgres;Password=postgres",
    "Redis": "redis:6379,abortConnect=false"
  },
  "Security": {
    "ApiKey": "",
    "RequireApiKey": true,
    "HeaderName": "X-Api-Key"
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": true,
    "KeyPrefix": "looksrating:rl",
    "Policies": {
      "Global": {
        "PermitLimit": 6000,
        "WindowSeconds": 60,
        "BurstPermitLimit": 200,
        "BurstWindowSeconds": 10
      },
      "GetNextPhoto": {
        "PermitLimit": 90,
        "WindowSeconds": 60,
        "BurstPermitLimit": 18,
        "BurstWindowSeconds": 10
      },
      "Rating": {
        "PermitLimit": 90,
        "WindowSeconds": 60,
        "BurstPermitLimit": 18,
        "BurstWindowSeconds": 10
      },
      "Writes": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "Payments": {
        "PermitLimit": 6,
        "WindowSeconds": 60
      },
      "Reads": {
        "PermitLimit": 300,
        "WindowSeconds": 60,
        "BurstPermitLimit": 50,
        "BurstWindowSeconds": 10
      },
      "AccountSensitive": {
        "PermitLimit": 5,
        "WindowSeconds": 3600
      },
      "Grpc": {
        "PermitLimit": 3600,
        "WindowSeconds": 3600
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "GroupId": "LooksRatingService",
    "Topics": {
      "PhotoRatedEvent": "photorated-events",
      "CurrencyDebitedEvent": "sparks-debited-events",
      "CurrencySparksEvent": "sparks-credited-events",
      "CurrencyDebitCompensatedEvent": "sparks-compensated-events",
      "CreateReviewEvent": "create-review-events"
    }
  },
  "KafkaConsumer": {
    "PhotoConsume": {
      "Topic": "photorated-events",
      "BootstrapServers": "kafka:29092",
      "GroupId": "photorated-v1"
    },
    "SparksCredits": {
      "Topic": "sparks-credited-events",
      "BootstrapServers": "kafka:29092",
      "GroupId": "sparks-credits-v1"
    },
    "SparksCompensation": {
      "Topic": "sparks-compensated-events",
      "BootstrapServers": "kafka:29092",
      "GroupId": "sparks-compensation-v1"
    },
    "SendUserReview": {
      "Topic": "create-review-events",
      "BootstrapServers": "kafka:29092",
      "GroupId": "send-user-review-v1"
    }
  },
  "Quartz": {
    "TimeZoneId": "Europe/Moscow",
    "UseClustering": false,
    "AutoCreateSchema": true,
    "SchedulerName": "LooksRatingScheduler",
    "MaxConcurrency": 10,
    "NewListSeasonCron": "0 0 0 1 1 ?",
    "NewSeasonCron": "0 0 0 1 2-12 ?",
    "TheBestWeekCron": "0 0 0 ? * MON",
    "VipStatusExpiryCron": "0 0 * * * ?",
    "VipTopSparksRewardHour": 10,
    "VipTopSparksRewardMinute": 0
  },
  "ReviewMilestoneNotifications": {
    "Enabled": true,
    "PendingBatchSize": 50
  },
  "SeasonRolloverNotifications": {
    "Enabled": true,
    "PendingBatchSize": 50,
    "EnqueueBatchSize": 500,
    "TtlDays": 45
  }
}

