# БД Ticket API
TICKET_DATABASE_URL=postgres://postgres:postgres@localhost:5434/LooksRatingTicketDb?sslmode=disable

# HTTP Ticket API
TICKET_HTTP_ADDR=:8090
TICKET_API_KEY=change_me_ticket_api_key

# HTTP основного LooksRatingApi (тот же API_KEY, что и у bot)
LOOKSRATING_HTTP_BASE_URL=http://localhost:8080
LOOKSRATING_GRPC_ADDRESS=localhost:8080
LOOKSRATING_API_KEY=default_secret_api_key

# Мониторинг (smoke checks, Quartz log rules, алерты)
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=60
MONITOR_ALERT_COOLDOWN_MINUTES=30
MONITOR_LOG_TAIL_LINES=100
MONITOR_DOCKER_COMPOSE_PROJECT=looksrating
MONITOR_ENABLE_DOCKER_LOGS=false
MONITOR_TGIFTS_ENABLED=true
MONITOR_TGIFTS_GRPC_ADDR=localhost:50051
MONITOR_TICKET_HEALTH_URL=http://127.0.0.1:8090/health

# Telegram getMe probe для основного бота
LOOKS_RATING_BOT_TOKEN=
