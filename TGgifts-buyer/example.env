#==========================================#
#          TG Gifts Buyer Config           #
#          LooksRating integration         #
#==========================================#

#=== Telegram (userbot) ====================#
# https://my.telegram.org/apps
API_ID=
API_HASH=

#=== App mode ==============================#
# vip_scheduler — только раз в 2 недели VIP-топ + подарки
# detector — только мониторинг новых подарков (как в оригинале)
# both — и расписание, и детектор
APP_MODE=vip_scheduler
VIP_GIFT_JOB_ENABLED=true
VIP_GIFT_INTERVAL_DAYS=14
STARTUP_GIFT_DISPATCH=false
VIP_GIFT_SEND_INTRO=false

#=== Bot Settings ==========================#
INTERVAL=10
TIMEZONE=Europe/Moscow
CHANNEL_ID=
LANGUAGE=RU

#=== Gift Settings =========================#
MIN_GIFT_PRICE=0
MAX_GIFT_PRICE=10000
GIFT_DELAY=5
NUM_GIFTS=1
VIP_GIFT_IDS=
GIFT_IDS=
GIFT_SUPPLY=
HIDE_SENDER_NAME=True
PURCHASE_NON_LIMITED_GIFTS=False

#=== LooksRating gRPC ======================#
LOOKSRATING_GRPC_ADDRESS=localhost:8080
LOOKSRATING_GRPC_TIMEOUT=120

#=== Optional manual recipients =============#
USE_LOOKSRATING_GRPC=false
USER_ID=
