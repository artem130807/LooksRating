TICKET_BOT_TOKEN=your_ticket_bot_token
# Токен основного LooksRating-бота — нужен для скачивания фото профилей в модерации
LOOKS_RATING_BOT_TOKEN=your_main_bot_token
TICKET_API_BASE_URL=http://localhost:8090
LOOKS_RATING_API_GRPC_ADDRESS=localhost:8081
TICKET_API_KEY=change_me_ticket_api_key
# Тот же прокси, что у основного бота (обязателен, если api.telegram.org недоступен напрямую)
TELEGRAM_PROXY=socks5://127.0.0.1:1080
# Логины создаются из LooksRatingTicketApi/data/admins.seed.json при docker compose up
# TICKET_TELEGRAM_TIMEOUT_SECONDS=60
# TICKET_TELEGRAM_STARTUP_RETRIES=8
# TICKET_MEDIA_TIMEOUT_SECONDS=45
