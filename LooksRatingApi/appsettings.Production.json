{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Information",
        "LooksRatingApi.Infrastructure.Quartz": "Information",
        "LooksRatingApi.Services": "Information"
      }
    }
  },
  "Quartz": {
    "TimeZoneId": "Europe/Moscow",
    "UseClustering": true,
    "AutoCreateSchema": true,
    "SchedulerName": "LooksRatingScheduler",
    "MaxConcurrency": 10,
    "NewListSeasonCron": "0 0 0 1 1 ?",
    "NewSeasonCron": "0 0 0 1 2-12 ?",
    "TheBestWeekCron": "0 0 0 ? * MON",
    "VipStatusExpiryCron": "0 0 * * * ?",
    "VipTopSparksRewardHour": 10,
    "VipTopSparksRewardMinute": 0
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": false,
    "KeyPrefix": "looksrating:rl",
    "Policies": {
      "Global": {
        "PermitLimit": 6000,
        "WindowSeconds": 60,
        "BurstPermitLimit": 200,
        "BurstWindowSeconds": 10
      },
      "GetNextPhoto": {
        "PermitLimit": 90,
        "WindowSeconds": 60,
        "BurstPermitLimit": 18,
        "BurstWindowSeconds": 10
      },
      "Rating": {
        "PermitLimit": 90,
        "WindowSeconds": 60,
        "BurstPermitLimit": 18,
        "BurstWindowSeconds": 10
      },
      "Writes": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "Payments": {
        "PermitLimit": 6,
        "WindowSeconds": 60
      },
      "Reads": {
        "PermitLimit": 300,
        "WindowSeconds": 60,
        "BurstPermitLimit": 50,
        "BurstWindowSeconds": 10
      },
      "AccountSensitive": {
        "PermitLimit": 5,
        "WindowSeconds": 3600
      },
      "Grpc": {
        "PermitLimit": 3600,
        "WindowSeconds": 3600
      }
    }
  }
}
