{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Information",
        "LooksRatingApi.Infrastructure.Quartz": "Information",
        "LooksRatingApi.Services": "Information"
      }
    }
  },
  "Quartz": {
    "TimeZoneId": "Europe/Samara",
    "UseClustering": true,
    "AutoCreateSchema": true,
    "SkipCalendarGuards": true,
    "SkipListSeasonNumberGuard": true,
    "MirrorProductionCron": false,
    "SchedulerName": "LooksRatingScheduler-Test",
    "MaxConcurrency": 10,
    "NewListSeasonCron": "0 0 17 * * ?",
    "NewSeasonCron": "0 59 16 * * ?",
    "TheBestWeekCron": "0 58 16 * * ?",
    "VipStatusExpiryCron": "0 57 16 * * ?"
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": ""
  },
  "KafkaConsumer": {
    "PhotoConsume": {
      "BootstrapServers": ""
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Quartz": "Information",
      "LooksRatingApi.Services": "Information"
    }
  }
}
