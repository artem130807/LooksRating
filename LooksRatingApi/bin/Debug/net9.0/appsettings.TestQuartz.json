{
  "Quartz": {
    "TimeZoneId": "Europe/Moscow",
    "UseClustering": true,
    "AutoCreateSchema": true,
    "SkipCalendarGuards": true,
    "SkipListSeasonNumberGuard": true,
    "MirrorProductionCron": false,
    "SchedulerName": "LooksRatingScheduler-Test",
    "MaxConcurrency": 10,
    "NewListSeasonCron": "0 43 16 * * ?",
    "NewSeasonCron": "0 42 16 * * ?",
    "TheBestWeekCron": "0 41 16 * * ?",
    "VipStatusExpiryCron": "0 40 16 * * ?"
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Quartz": "Information",
      "LooksRatingApi.Services": "Information"
    }
  }
}
