# Скопируйте в .env: cp .env.example .env
#
# Локальная разработка / staging:
#   docker compose up -d --build --scale api=2
#
# Production (VPS, 2 реплики API, закрытые порты БД):
#   chmod +x scripts/prod-up.sh
#   ./scripts/prod-up.sh
#
# API с хоста: http://localhost:8080 (через api-gateway)

TELEGRAM_BOT_TOKEN=your_main_bot_token_here
API_KEY=change_me_to_a_long_random_secret
POSTGRES_PASSWORD=change_me_strong_postgres_password

# Админ-бот жалоб (LooksRatingTicketBot + LooksRatingTicketApi)
TICKET_BOT_TOKEN=your_ticket_bot_token_here
TICKET_API_KEY=change_me_ticket_api_key_hex
TICKET_POSTGRES_PASSWORD=change_me_strong_ticket_postgres_password

# Опционально: порт gateway на хосте (по умолчанию 8080)
# API_GATEWAY_PORT=8080

# Имя проекта для docker compose и мониторинга ticket-api
COMPOSE_PROJECT_NAME=looksrating

# Мониторинг Ticket API (логи через docker.sock на VPS)
# MONITOR_ENABLED=true
# MONITOR_ENABLE_DOCKER_LOGS=true
# MONITOR_INTERVAL_SECONDS=60
# MONITOR_ALERT_COOLDOWN_MINUTES=30

# Опционально для tgifts-buyer в compose
# TGIFTS_APP_MODE=vip_scheduler
# TGIFTS_CHANNEL_ID=0
